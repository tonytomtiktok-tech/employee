# Server-only secrets — never expose to the browser or commit real values.

# Phase 1 — Auth.js / Google Workspace OIDC
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Phase 2 — Google Sheets service account (private spreadsheet only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# App
APP_TIMEZONE=Asia/Bangkok
PRIVACY_THRESHOLD=5
NEXT_PUBLIC_APP_NAME=AssessFlow
